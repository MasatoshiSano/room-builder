# Backend selector. Default = local Hono+SQLite server.
# Set to "s3" to talk directly to AWS S3 from the browser.
VITE_BACKEND_MODE=server

# When VITE_BACKEND_MODE=s3, the following are required.
# WARNING: anything starting with VITE_ is INLINED INTO THE CLIENT BUNDLE.
# Use ONLY for local / intranet / single-user use; lock the IAM user down
# to s3:* on this single bucket (see scripts/aws-setup.sh for a sample policy).
VITE_AWS_REGION=ap-northeast-1
VITE_AWS_BUCKET=room-builder-data-863646532781
# Optional prefix inside the bucket (no leading/trailing slash).
VITE_AWS_PREFIX=

VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=

# Override the local API base URL for the dev proxy if needed (default: http://localhost:3001).
# VITE_API_URL=http://localhost:3001
